# Server
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

# OANDA practice (demo) account — free forever, sign up at https://www.oanda.com/forex-trading/
# After signup: My Account -> My Services -> Manage API Access -> generate a personal access token
OANDA_API_TOKEN=your_oanda_practice_token
OANDA_ENV=practice

# JBlanked Calendar API — free key at https://www.jblanked.com/api/key/
# Free tier is limited to 1 request/day, which is why we only poll once daily (see calendarService.js)
CALENDAR_API_KEY=your_jblanked_key

# Marketaux news API — free key at https://www.marketaux.com/ (~100 requests/day on free tier)
MARKETAUX_API_KEY=your_marketaux_key

# Anthropic API key — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_key

# --- Signal engine tuning ---
# How long a majority vote must hold before a signal is confirmed (filters noise)
CONFIRM_WINDOW_SECONDS=90
# Candle timeframe used for indicators: M1, M5, M15 etc. (OANDA granularity codes)
CANDLE_GRANULARITY=M1
# How many candles of history to keep for indicator calculation
CANDLE_COUNT=210
# How often to poll price candles
POLL_INTERVAL_SECONDS=20
# Reward:risk ratio used to place TP relative to SL (both measured in ATR)
RISK_REWARD_RATIO=1.5
# How often to poll news headlines (minutes) — kept low to respect free-tier limits
NEWS_POLL_MINUTES=15
